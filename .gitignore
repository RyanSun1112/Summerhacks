node_modules/
venv/
__pycache__/
*.db
*.db-wal
*.db-shm

# Python preprocessing environment and generated caches
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
/cache/

# tunnel binary — everyone downloads their own, it's ~70MB
cloudflared
cloudflared.exe

# floor plan images uploaded through the venue editor — binaries, sometimes
# large. The venue JSON beside them IS tracked, so a venue you build can be
# committed and shared; only the traced-over image stays local.
venues/*-plan.png

# local overrides
.env
.env.local

# local venue-owner accounts: scrypt password hashes and live session tokens.
# Machine-specific by definition and secret by content — never commit.
/data/owners.json

# editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# audio dropped in for the radio player
*.mp3
*.m4a
*.wav
*.flac
/audio/
# Event library. Only redistribution-safe audio should be committed here.
/songs/*
!/songs/README.md
!/songs/**/*.mp3
!/songs/**/*.m4a
!/songs/**/*.wav
!/songs/**/*.flac

# Rebuildable preprocessing diagnostics (the final songProfiles.json may be committed)
/data/tracks.json
/data/rawAudioFeatures.json
/data/rawLLMAnnotations.json
/data/songPreprocessingReport.json
