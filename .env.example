# Copy to .env and fill in from the Supabase project settings.
# Never put SUPABASE_SERVICE_ROLE_KEY in any HTML or client code.

PORT=3000
# PUBLIC_URL=https://your-tunnel.trycloudflare.com

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth tip for the hackathon: in Supabase Dashboard → Authentication →
# Providers → Email, turn OFF "Confirm email" so sign-up works instantly
# without fighting email deliverability tonight.
# Copy this file to ".env" and fill in what you need.
# .env is gitignored — your real keys never get committed.
# Anything set in the shell still wins over what's here.

# --- AI plan reading in the venue editor (optional) ---
# Set ONE of these. Without either, the editor uses its built-in local reader.
OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here

# Only needed if both keys above are set
# AI_PROVIDER=openai

# Vision models. Defaults are gpt-4o and gemini-2.0-flash
# OPENAI_MODEL=gpt-5.4
# GEMINI_MODEL=gemini-2.0-flash

# --- everything else is optional ---
# PUBLIC_URL=https://your-tunnel.trycloudflare.com
# PORT=3000
# FAKE=0
# FAKE_N=120
