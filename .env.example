# Copy this file to ".env" and fill in what you need.
# .env is gitignored — your real keys never get committed.
# Anything set in the shell still wins over what's here.

# PORT=3000
# PUBLIC_URL=https://your-tunnel.trycloudflare.com

# --- AI plan reading in the venue editor (optional) ---
# Set ONE of these. Without either, the editor uses its built-in local reader.
OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here

# Only needed if both keys above are set
# AI_PROVIDER=openai

# Vision models. Defaults are gpt-5.4 and gemini-2.0-flash
# OPENAI_MODEL=gpt-5.4
# GEMINI_MODEL=gemini-2.0-flash

# --- venue-owner accounts (optional) ---
# Default is LOCAL mode: accounts live in the same SQLite db as sensor
# snapshots (backend/data.db); data/owners.json is only the fallback when
# better-sqlite3 is unavailable. Sign up from the dashboard, zero setup.
# To disable accounts entirely:
# AUTH_MODE=off
#
# To use Supabase instead, set all three (from the project's API settings).
# Never put SUPABASE_SERVICE_ROLE_KEY in any HTML or client code.
# Hackathon tip: Supabase Dashboard → Authentication → Providers → Email →
# turn OFF "Confirm email" so sign-up works instantly.
# After creating the project, run supabase/schema.sql (venue_owners + captures
# + the public "captures" storage bucket). Vibe captures need Supabase.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- city map (optional) ---
# Public Mapbox token for /city.html 3D buildings (pk.…). Restrict by URL in Mapbox.
# MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# --- everything else is optional ---
# FAKE=0
# FAKE_N=120
# VENUE=stackt
