# Copy this file to ".env" and fill in what you need.
# .env is gitignored — your real keys never get committed.
# Anything set in the shell still wins over what's here.
#
# === Render deploy (Environment tab) — .env is NOT uploaded ===
# Required for the judged demo:
#   AUTH_MODE=supabase
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
#   FAKE=0
#   PUBLIC_URL=https://YOUR-SERVICE.onrender.com   (optional if RENDER_EXTERNAL_URL works)
# Also run supabase/schema.sql on THAT Supabase project (SQL editor).
# Optional: OPENAI_API_KEY, GEMINI_API_KEY, DJ_AI_TOKEN

# PORT=3000
# PUBLIC_URL=https://your-tunnel.trycloudflare.com

# --- AI plan reading in the venue editor (optional) ---
# Set ONE of these. Without either, the editor uses its built-in local reader.
OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here

# Only needed if both keys above are set
# AI_PROVIDER=openai

# Vision models. Defaults are gpt-5.4 and gemini-2.0-flash
# OPENAI_MODEL=gpt-5.4
# GEMINI_MODEL=gemini-2.0-flash

# --- venue-owner accounts ---
# Deploy / judged demo: set AUTH_MODE=supabase and all three SUPABASE_* keys.
# Never put SUPABASE_SERVICE_ROLE_KEY in any HTML or client code.
# Hackathon tip: Supabase Dashboard → Authentication → Providers → Email →
# turn OFF "Confirm email" so sign-up works instantly.
# After creating the project, run supabase/schema.sql (venue_owners + captures
# + the public "captures" storage bucket). Vibe captures need Supabase.
AUTH_MODE=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Local projector with no accounts:
# AUTH_MODE=off

# --- city map ---
# city.html uses Leaflet + CARTO (no Mapbox key required).
# MAPBOX_ACCESS_TOKEN is unused.

# --- crowd / demo ---
# Unset FAKE defaults to a simulated crowd (58). For a real judged demo:
FAKE=0
# FAKE_N=120
# VENUE=stackt

# --- deployed audio catalogue ---
# Defaults to ./songs. Override only when running against an external library.
# SONGS_DIR=./songs
