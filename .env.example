# Copy to .env and fill in from the Supabase project settings.
# Never put SUPABASE_SERVICE_ROLE_KEY in any HTML or client code.

PORT=3000
# PUBLIC_URL=https://your-tunnel.trycloudflare.com

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Mapbox token for /city.html 3D buildings (pk.…). Restrict by URL in Mapbox.
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# After creating the project, run supabase/schema.sql (venue_owners + captures
# + the public "captures" storage bucket).

# Auth tip: Authentication → Providers → Email → turn OFF "Confirm email"
# for the hackathon so sign-up works without email deliverability.
