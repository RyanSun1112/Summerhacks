# Copy to .env and fill in from the Supabase project settings.
# Never put SUPABASE_SERVICE_ROLE_KEY in any HTML or client code.

PORT=3000
# PUBLIC_URL=https://your-tunnel.trycloudflare.com

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth tip for the hackathon: in Supabase Dashboard → Authentication →
# Providers → Email, turn OFF "Confirm email" so sign-up works instantly
# without fighting email deliverability tonight.
